# Copia este archivo como .env y completa los valores
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tracehelp:tracehelp@localhost:5432/tracehelp
# Clave para firmar los tokens: usa una cadena aleatoria de al menos 32 caracteres
JWT_SECRET_KEY=change-me-por-una-clave-larga-y-aleatoria-de-32-caracteres
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RAG_MIN_EVIDENCE_THRESHOLD=0.70
RAG_SELF_SERVICE_THRESHOLD=0.85
RAG_TOP_K=5
RESEND_API_KEY=
# Clave del sello HMAC de anonimización (T27): cadena aleatoria de al menos 32 caracteres
PII_AUDIT_SECRET=change-me-por-otra-clave-larga-y-aleatoria-de-32-caracteres
# Hilos del worker de ingesta de manuales en segundo plano (T23)
INGESTION_WORKERS=2
