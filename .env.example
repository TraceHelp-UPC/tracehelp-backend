# Copia este archivo como .env y completa los valores
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tracehelp:tracehelp@localhost:5432/tracehelp
# Clave para firmar los tokens: usa una cadena aleatoria de al menos 32 caracteres
JWT_SECRET_KEY=change-me-por-una-clave-larga-y-aleatoria-de-32-caracteres
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RESEND_API_KEY=
# Clave del sello HMAC de anonimización (T27): cadena aleatoria de al menos 32 caracteres
PII_AUDIT_SECRET=change-me-por-otra-clave-larga-y-aleatoria-de-32-caracteres
# Hilos del worker de ingesta de manuales en segundo plano (T23)
INGESTION_WORKERS=2
# Hilos del worker de triaje automatico de tickets en segundo plano (T28)
TRIAGE_WORKERS=1
# Umbrales de similitud coseno de la evidencia (T30, calibrados en T33): fuente de la respuesta y autoservicio
SIMILARITY_THRESHOLD=0.68
SELF_SERVICE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
# Scheduler de tareas periodicas (T60): SCHEDULER_ENABLED=false lo apaga; un intervalo <= 0 apaga ese job
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
JOB_HEARTBEAT_INTERVAL_SECONDS=60
JOB_RELEASE_INACTIVE_TICKETS_INTERVAL_SECONDS=300
JOB_AUTO_CLOSE_RESOLVED_TICKETS_INTERVAL_SECONDS=3600
JOB_KNOWLEDGE_GAP_ANALYSIS_INTERVAL_SECONDS=86400
